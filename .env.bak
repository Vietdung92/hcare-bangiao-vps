# ============================================================
# Environment Variables - HCARE Bàn Giao API
# ============================================================

# Server
NODE_ENV=production
PORT=3004
HOST=0.0.0.0

# Database
DATABASE_PATH=./database/hcare-bangiao.db

# JWT (Bảo mật token)
JWT_SECRET=your-secret-key-change-me-12345-hcare-2026
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Email (tạm thời chưa cần)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_USER=hcarevietnam.info@gmail.com
EMAIL_PASS=liqauzxsohcfpuzh
EMAIL_FROM=HCARE Bàn Giao <hcarevietnam.info@gmail.com>
cat >> ~/hcare-bangiao/backend/.env << 'EOF'
VAPID_PUBLIC=BNdwqIqUFBHOiCHjl2jbnJE0uI7_PBwgfZuFsdTZSUddTKbIfaoQH_q4mNAlAZHsbhQ4rIdswmHir7N4WvsjVGY
VAPID_PRIVATE=4F_OX64usuf1tAglyo8Brx9tg8bWFqNhEAaM9H0f7GKc
VAPID_EMAIL=mailto:hcarevietnam.info@gmail.com
EOFsqlite3 ~/hcare-bangiao/backend/database/hcare-bangiao.db "CREATE TABLE IF NOT EXISTS push_subscription (ma_nv TEXT PRIMARY KEY, subscription_json TEXT NOT NULL, ngay_cap_nhat DATETIME DEFAULT CURRENT_TIMESTAMP);"

sed -i "s|app.use('/api/email'|app.use('/api/notify', require('./routes/notify'));\napp.use('/api/email'|" ~/hcare-bangiao/backend/src/app.js

pm2 restart hcare-bangiao
sleep 2
pm2 logs hcare-bangiao --lines 5 --nostream
