const { verifyToken, requireQuanLy } = require('../middleware/auth');

const router = express.Router();

// GET /api/can-ho - Danh sách tất cả căn hộ
router.get('/', verifyToken, async (req, res) => {
  try {
    const db = await getDB();
    
    const canHos = await db.all(`
      SELECT * FROM can_ho 
      WHERE trang_thai = 'HoatDong'
      ORDER BY ma_can ASC
    `);

    res.status(200).json({
      thanhCong: true,
      thongBao: 'Lấy danh sách căn hộ thành công',
      tongSo: canHos.length,
      data: canHos,
      timestamp: new Date().toISOString()
    });

  } catch (err) {
    console.error('GET /can-ho error:', err);
    res.status(500).json({
      thanhCong: false,
      thongBao: 'Lỗi server',
      code: 'SERVER_ERROR'
    });
  }
});

// GET /api/can-ho/:id - Chi tiết 1 căn
router.get('/:id', verifyToken, async (req, res) => {
  try {
    const { id } = req.params;
    const db = await getDB();

    const canHo = await db.get(
      'SELECT * FROM can_ho WHERE id = ? AND trang_thai = ?',
      [id, 'HoatDong']
    );

    if (!canHo) {
      return res.status(404).json({
        thanhCong: false,
        thongBao: 'Căn hộ không tồn tại',
        code: 'NOT_FOUND'
      });
    }

    res.status(200).json({
      thanhCong: true,
      thongBao: 'Lấy chi tiết căn hộ thành công',
      data: canHo,
      timestamp: new Date().toISOString()
    });

  } catch (err) {
    console.error('GET /can-ho/:id error:', err);
    res.status(500).json({
      thanhCong: false,
      thongBao: 'Lỗi server',
      code: 'SERVER_ERROR'
    });
  }
});

// POST /api/can-ho - Tạo mới căn hộ (Quản lý)
router.post('/', verifyToken, requireQuanLy, async (req, res) => {
  try {
    const { ma_can, ten_toa_nha, dia_chi, so_pn, so_wc, khuvuc_dacbiet, ghi_chu } = req.body;

    // Validate
    if (!ma_can || !ten_toa_nha) {
      return res.status(400).json({
        thanhCong: false,
        thongBao: 'Mã căn & tên tòa nhà bắt buộc',
        code: 'MISSING_FIELDS'
      });
    }

    const db = await getDB();

    // Kiểm tra mã căn đã tồn tại
    const existing = await db.get('SELECT id FROM can_ho WHERE ma_can = ?', [ma_can]);
    if (existing) {
      return res.status(400).json({
        thanhCong: false,
        thongBao: 'Mã căn hộ đã tồn tại',
        code: 'DUPLICATE_MA_CAN'
      });
    }

    // Tạo mới
    const result = await db.run(
      `INSERT INTO can_ho (ma_can, ten_toa_nha, dia_chi, so_pn, so_wc, khuvuc_dacbiet, ghi_chu, trang_thai)
       VALUES (?, ?, ?, ?, ?, ?, ?, 'HoatDong')`,
      [ma_can, ten_toa_nha, dia_chi || null, so_pn || 2, so_wc || 2, khuvuc_dacbiet || null, ghi_chu || null]
    );

    res.status(201).json({
      thanhCong: true,
      thongBao: 'Tạo căn hộ thành công',
      id: result.lastID,
      timestamp: new Date().toISOString()
    });

  } catch (err) {
    console.error('POST /can-ho error:', err);
    res.status(500).json({
      thanhCong: false,
      thongBao: 'Lỗi server',
      code: 'SERVER_ERROR'
    });
  }
});

// PUT /api/can-ho/:id - Cập nhật căn hộ (Quản lý)
router.put('/:id', verifyToken, requireQuanLy, async (req, res) => {
  try {
    const { id } = req.params;
    const { ten_toa_nha, dia_chi, so_pn, so_wc, khuvuc_dacbiet, ghi_chu } = req.body;

    const db = await getDB();

    // Kiểm tra căn hộ tồn tại
    const canHo = await db.get('SELECT * FROM can_ho WHERE id = ?', [id]);
    if (!canHo) {
      return res.status(404).json({
        thanhCong: false,
        thongBao: 'Căn hộ không tồn tại',
        code: 'NOT_FOUND'
      });
    }

    // Cập nhật
    await db.run(
      `UPDATE can_ho SET 
       ten_toa_nha = ?, dia_chi = ?, so_pn = ?, so_wc = ?, 
       khuvuc_dacbiet = ?, ghi_chu = ?, ngay_cap_nhat = CURRENT_TIMESTAMP
       WHERE id = ?`,
      [
        ten_toa_nha || canHo.ten_toa_nha,
        dia_chi || canHo.dia_chi,
        so_pn || canHo.so_pn,
        so_wc || canHo.so_wc,
        khuvuc_dacbiet || canHo.khuvuc_dacbiet,
        ghi_chu || canHo.ghi_chu,
        id
      ]
    );

    res.status(200).json({
      thanhCong: true,
      thongBao: 'Cập nhật căn hộ thành công',
      timestamp: new Date().toISOString()
    });

  } catch (err) {
    console.error('PUT /can-ho/:id error:', err);
    res.status(500).json({
      thanhCong: false,
      thongBao: 'Lỗi server',
      code: 'SERVER_ERROR'
    });
  }
});

// DELETE /api/can-ho/:id - Xóa căn hộ (Quản lý)
router.delete('/:id', verifyToken, requireQuanLy, async (req, res) => {
  try {
    const { id } = req.params;
    const db = await getDB();

    // Kiểm tra căn hộ tồn tại
    const canHo = await db.get('SELECT * FROM can_ho WHERE id = ?', [id]);
    if (!canHo) {
      return res.status(404).json({
        thanhCong: false,
        thongBao: 'Căn hộ không tồn tại',
        code: 'NOT_FOUND'
      });
    }

    // Soft delete (cập nhật trang_thai)
    await db.run(
      'UPDATE can_ho SET trang_thai = ?, ngay_cap_nhat = CURRENT_TIMESTAMP WHERE id = ?',
      ['DaXoa', id]
    );

    res.status(200).json({
      thanhCong: true,
      thongBao: 'Xóa căn hộ thành công',
      timestamp: new Date().toISOString()
    });

  } catch (err) {
    console.error('DELETE /can-ho/:id error:', err);
    res.status(500).json({
      thanhCong: false,
      thongBao: 'Lỗi server',
      code: 'SERVER_ERROR'
    });
  }
});

module.exports = router;const express = require('express');
